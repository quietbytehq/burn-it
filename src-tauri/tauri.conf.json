{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Burn It!",
  "mainBinaryName": "burn-it",
  "version": "0.1.0",
  "identifier": "io.github.quietbytehq.burnit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Burn It!",
        "width": 560,
        "height": 640,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Write Linux and Windows ISOs to USB",
    "longDescription": "Burn It! makes bootable USB drives from Linux and Windows ISO images. Free and open source by Quiet Byte.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "policykit-1 | pkexec",
          "parted",
          "dosfstools",
          "wimtools",
          "util-linux"
        ],
        "files": {
          "/usr/share/polkit-1/actions/io.github.quietbytehq.burnit.policy": "polkit/io.github.quietbytehq.burnit.policy"
        }
      },
      "rpm": {
        "depends": [
          "polkit",
          "parted",
          "dosfstools",
          "wimlib-utils",
          "util-linux"
        ],
        "files": {
          "/usr/share/polkit-1/actions/io.github.quietbytehq.burnit.policy": "polkit/io.github.quietbytehq.burnit.policy"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}