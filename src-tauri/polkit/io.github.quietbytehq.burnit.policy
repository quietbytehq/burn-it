<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Quiet Byte</vendor>
  <vendor_url>https://github.com/quietbytehq/burn-it</vendor_url>
  <action id="io.github.quietbytehq.burnit.write">
    <description>Write an image to a USB drive</description>
    <message>Burn It! needs your permission to erase and write to the USB drive.</message>
    <icon_name>burn-it</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/burn-it</annotate>
  </action>
</policyconfig>
